# Copy this file to .env  (PowerShell:  Copy-Item .env.example .env)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: sqlite (default) | postgres | mysql
DB_ENGINE=sqlite
DB_NAME=campussphere
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional AI provider for the chatbot (leave blank to use the built-in database assistant)
# AI_PROVIDER = none | anthropic | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Notification delivery (email/SMS/Web Push). Store real secrets only in backend/.env.
FRONTEND_ORIGIN=http://localhost:8000
DEFAULT_FROM_EMAIL=CampusSphere <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set to the public HTTPS URL that receives Twilio status callbacks.
TWILIO_STATUS_CALLBACK_URL=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_CONTACT=mailto:admin@example.com
